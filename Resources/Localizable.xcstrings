{
  "sourceLanguage" : "en",
  "strings" : {
    "About" : {
      "comment" : "Settings tab",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О программе"
          }
        }
      }
    },
    "Accessibility" : {
      "comment" : "The Accessibility permission, named as System Settings names it before macOS 27",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ"
          }
        }
      }
    },
    "Add Language…" : {
      "comment" : "Settings ▸ Languages: adds a language to the list",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить язык…"
          }
        }
      }
    },
    "Add Layout…" : {
      "comment" : "Settings ▸ Languages: opens System Settings ▸ Keyboard",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить раскладку…"
          }
        }
      }
    },
    "Add a second keyboard layout to fix text typed in the wrong one. Layouts come from System Settings ▸ Keyboard ▸ Input Sources." : {
      "comment" : "Settings ▸ Languages: Fix Layout with one layout in macOS",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте вторую раскладку, чтобы исправлять текст, набранный не в той. Раскладки берутся из Системных настроек ▸ Клавиатура ▸ Источники ввода."
          }
        }
      }
    },
    "Allowed" : {
      "comment" : "Settings ▸ General: Accessibility status",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешён"
          }
        }
      }
    },
    "Already used by" : {
      "comment" : "Settings ▸ Shortcuts: before the other command's name",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже занято:"
          }
        }
      }
    },
    "Another app may listen for the same keys, and macOS does not say so. If a shortcut does nothing, pick another." : {
      "comment" : "Settings ▸ Shortcuts: clashes with other apps go unreported",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая программа может слушать те же клавиши, и macOS об этом не сообщает. Если сочетание не срабатывает, выберите другое."
          }
        }
      }
    },
    "Apple does not translate between these languages." : {
      "comment" : "Translation panel",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не переводит между этими языками."
          }
        }
      }
    },
    "Automatic" : {
      "comment" : "Settings ▸ Languages: no fixed language",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически"
          }
        }
      }
    },
    "Automatic recognizes the language of each selection. Pick one only if it keeps getting yours wrong." : {
      "comment" : "Settings ▸ Languages: what Automatic means for Read text as",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» определяет язык каждого выделения. Выберите язык, только если ваш постоянно определяется неверно."
          }
        }
      }
    },
    "Back to the default shortcut" : {
      "comment" : "Settings ▸ Shortcuts: the reset button, read by VoiceOver and shown as its tooltip",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернуть сочетание по умолчанию"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button: close the alert",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить"
          }
        }
      }
    },
    "Changelog" : {
      "comment" : "Settings ▸ About: opens the release notes",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История изменений"
          }
        }
      }
    },
    "Click a shortcut, then press the new keys. Esc cancels; ⌫ leaves the command without one." : {
      "comment" : "Settings ▸ Shortcuts: how to change a shortcut",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на сочетание, затем новые клавиши. Esc — отмена, ⌫ — оставить команду без сочетания."
          }
        }
      }
    },
    "Copied" : {
      "comment" : "Translation panel: after the translation was copied",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопировано"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Translation panel: copies the translation",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копировать"
          }
        }
      }
    },
    "Couldn’t reset the permission" : {
      "comment" : "Alert after tccutil failed: title",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сбросить разрешение"
          }
        }
      }
    },
    "Device Control and Data Access" : {
      "comment" : "The Accessibility permission, named as System Settings names it on macOS 27 and later",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление устройством и доступ к данным"
          }
        }
      }
    },
    "Fix Layout" : {
      "comment" : "Command: retype the selection in the other keyboard layout",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправить раскладку"
          }
        }
      }
    },
    "Fix Layout and Translate need it to copy the selected text, and Fix Layout to paste the fixed text back." : {
      "comment" : "Settings ▸ General: why Accessibility is needed",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без него «Исправить раскладку» и «Перевести» не смогут скопировать выделенный текст, а «Исправить раскладку» — вставить исправленный."
          }
        }
      }
    },
    "Fix Layout retypes text between the layouts switched on here, two at least. Layouts come from System Settings ▸ Keyboard ▸ Input Sources, and one you add there joins them." : {
      "comment" : "Settings ▸ Languages: how Fix Layout uses the layouts",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Исправить раскладку» перепечатывает текст между раскладками, включёнными здесь, — нужны хотя бы две. Раскладки берутся из Системных настроек ▸ Клавиатура ▸ Источники ввода, и добавленная там включится здесь сама."
          }
        }
      }
    },
    "Fixes text typed in the wrong keyboard layout and translates the selection." : {
      "comment" : "Settings ▸ About: what SmartType does",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправляет текст, набранный не в той раскладке, и переводит выделенное."
          }
        }
      }
    },
    "General" : {
      "comment" : "Settings tab",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основные"
          }
        }
      }
    },
    "Grant Access…" : {
      "comment" : "Button and menu item: add SmartType to the Accessibility list and open it",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ…"
          }
        }
      }
    },
    "Grant Access… restarts SmartType and opens that list: switch it on there." : {
      "comment" : "Alert when a command runs without Accessibility: after the permission's name",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Разрешить доступ…» перезапустит SmartType и откроет этот список: включите его там."
          }
        }
      }
    },
    "Grant Access… restarts SmartType and opens the list in System Settings: switch SmartType on there. An entry an update left behind is cleared on the way." : {
      "comment" : "Settings ▸ General: what Grant Access does",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Разрешить доступ…» перезапускает SmartType и открывает список в Системных настройках: включите там SmartType. Запись, оставшаяся после обновления, по пути удаляется."
          }
        }
      }
    },
    "Hold ⌃, or ⌘ together with ⌥." : {
      "comment" : "Settings ▸ Shortcuts: refused modifiers",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна ⌃ или ⌘ вместе с ⌥."
          }
        }
      }
    },
    "Keyboard Shortcuts" : {
      "comment" : "Submenu listing the global shortcuts",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки хоткеев"
          }
        }
      }
    },
    "Languages" : {
      "comment" : "Settings tab",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Языки"
          }
        }
      }
    },
    "Made with ❤ by Alex Karatai" : {
      "comment" : "Settings header and About: the author's signature",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделано с ❤ — Alex Karatai"
          }
        }
      }
    },
    "Make Primary" : {
      "comment" : "Settings ▸ Languages: moves a language to the top",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделать основным"
          }
        }
      }
    },
    "Needs macOS 26" : {
      "comment" : "Menu: why Translate is greyed out",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна macOS 26"
          }
        }
      }
    },
    "None" : {
      "comment" : "Settings ▸ Shortcuts: a command without a shortcut",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет"
          }
        }
      }
    },
    "Not allowed" : {
      "comment" : "Settings ▸ General: Accessibility status",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не разрешён"
          }
        }
      }
    },
    "Open Login Items…" : {
      "comment" : "Settings ▸ General: button that opens System Settings' Login Items",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть объекты входа…"
          }
        }
      }
    },
    "Open Translation Languages…" : {
      "comment" : "Translation panel: opens System Settings",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть «Языки перевода»…"
          }
        }
      }
    },
    "Open at Login" : {
      "comment" : "Settings ▸ General: the switch that starts SmartType at login, named as macOS names it",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывать при входе"
          }
        }
      }
    },
    "Opens System Settings ▸ Keyboard, where Edit… next to Input Sources adds one." : {
      "comment" : "Settings ▸ Languages: tooltip of Add Layout…, with the pane's own names",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает Системные настройки ▸ Клавиатура: раскладку добавляет «Изменить…» у «Источников ввода»."
          }
        }
      }
    },
    "Primary" : {
      "comment" : "Settings ▸ Languages: the language translations go into",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной"
          }
        }
      }
    },
    "Quit SmartType" : {
      "comment" : "Status menu item",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход"
          }
        }
      }
    },
    "Read text as" : {
      "comment" : "Settings ▸ Languages: the language of the selection",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык текста"
          }
        }
      }
    },
    "Remove" : {
      "comment" : "Settings ▸ Languages: removes a language from the list",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить"
          }
        }
      }
    },
    "Run this command in Terminal:" : {
      "comment" : "Alert after tccutil failed: before the command",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните эту команду в Терминале:"
          }
        }
      }
    },
    "Settings…" : {
      "comment" : "Status menu item that opens the Settings window",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки…"
          }
        }
      }
    },
    "Shortcuts" : {
      "comment" : "Settings tab",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоткеи"
          }
        }
      }
    },
    "SmartType Settings" : {
      "comment" : "Settings window title, read out by VoiceOver",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки SmartType"
          }
        }
      }
    },
    "SmartType borrows the clipboard to fix or translate the selection and gives it back afterwards. Allow it in System Settings ▸ Privacy & Security ▸ Paste from Other Apps, then quit and reopen SmartType." : {
      "comment" : "Alert when pasting is denied: how to allow it",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType берёт буфер обмена на время исправления или перевода и потом возвращает его. Разрешите это в Системных настройках ▸ Конфиденциальность и безопасность ▸ Вставка из других приложений, затем закройте и снова откройте SmartType."
          }
        }
      }
    },
    "SmartType can’t read the clipboard" : {
      "comment" : "Alert when pasting is denied: title",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType не может прочитать буфер обмена"
          }
        }
      }
    },
    "SmartType copies the selected text to fix or translate it, and pastes a fix back. macOS allows that only to apps switched on in System Settings ▸ Privacy & Security ▸" : {
      "comment" : "Alert when a command runs without Accessibility: followed by the permission's name",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType копирует выделенный текст, чтобы исправить или перевести его, и вставляет исправленный. macOS разрешает это только приложениям, включённым в Системных настройках ▸ Конфиденциальность и безопасность ▸"
          }
        }
      }
    },
    "SmartType is turned off in System Settings’ Login Items. Turn it on there." : {
      "comment" : "Settings ▸ General: Open at Login was turned off in System Settings",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType выключен в объектах входа в Системных настройках. Включите его там."
          }
        }
      }
    },
    "SmartType needs a permission" : {
      "comment" : "Alert when a command runs without Accessibility: title",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType нужно разрешение"
          }
        }
      }
    },
    "Space" : {
      "comment" : "The space bar, in a shortcut",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробел"
          }
        }
      }
    },
    "Starts SmartType when you log in, so the shortcuts work from the start." : {
      "comment" : "Settings ▸ General: what Open at Login does",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SmartType запускается при входе в систему, и сочетания клавиш работают сразу."
          }
        }
      }
    },
    "Switch on a second layout to fix text typed in the wrong one." : {
      "comment" : "Settings ▸ Languages: Fix Layout with one layout left on",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите вторую раскладку, чтобы исправлять текст, набранный не в той."
          }
        }
      }
    },
    "Text in any other language is translated into the primary one, and text in the primary one into the next. The list also helps recognize short words." : {
      "comment" : "Settings ▸ Languages: how the list decides a translation",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст на любом другом языке переводится на основной, а текст на основном — на следующий в списке. Список также помогает распознавать короткие слова."
          }
        }
      }
    },
    "The translation did not work. Try again." : {
      "comment" : "Translation panel",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевести не получилось. Попробуйте ещё раз."
          }
        }
      }
    },
    "These languages are not downloaded yet: General → Language & Region → Translation Languages… in System Settings." : {
      "comment" : "Translation panel: the language pair needs downloading",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти языки ещё не скачаны: Основные → Язык и регион → Языки перевода… в Системных настройках."
          }
        }
      }
    },
    "They work in any app and in any keyboard layout." : {
      "comment" : "Settings ▸ Shortcuts: intro",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работают в любом приложении и в любой раскладке."
          }
        }
      }
    },
    "This key can’t be part of a shortcut." : {
      "comment" : "Settings ▸ Shortcuts: refused key",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта клавиша не подходит для сочетания."
          }
        }
      }
    },
    "Too long to translate here: over 2,000 characters." : {
      "comment" : "Translation panel",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком длинно для перевода здесь: больше 2000 символов."
          }
        }
      }
    },
    "Translate" : {
      "comment" : "Command: translate the selection",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевести"
          }
        }
      }
    },
    "Translating…" : {
      "comment" : "Translation panel: while the engine works",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевожу…"
          }
        }
      }
    },
    "Translation needs macOS 26." : {
      "comment" : "Translation panel and Settings ▸ Languages: before macOS 26",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для перевода нужна macOS 26."
          }
        }
      }
    },
    "Type Shortcut…" : {
      "comment" : "Settings ▸ Shortcuts: while recording",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите сочетание…"
          }
        }
      }
    },
    "Version" : {
      "comment" : "Settings ▸ About, before the version number",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия"
          }
        }
      }
    },
    "Your languages" : {
      "comment" : "Settings ▸ Languages: the list's heading",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши языки"
          }
        }
      }
    },
    "macOS already uses it." : {
      "comment" : "Settings ▸ Shortcuts: a system shortcut",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сочетание уже занято macOS."
          }
        }
      }
    },
    "macOS did not change it. Try again, or set it in System Settings’ Login Items." : {
      "comment" : "Settings ▸ General: macOS refused to change Open at Login",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
