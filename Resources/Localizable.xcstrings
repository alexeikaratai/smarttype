    "Fix Layout" : {
      "comment" : "Command: retype the selection in the other keyboard layout",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправить раскладку"
          }
        }
      }
    },
    "Fix Layout needs it to copy the selected text and paste the fixed text back." : {
      "comment" : "Settings ▸ General: why Accessibility is needed",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без него «Исправить раскладку» не сможет скопировать выделенный текст и вставить исправленный."
          }
        }
      }
    },
    "Fixes text typed in the wrong keyboard layout and translates the selection." : {
      "comment" : "Settings ▸ About: what SmartType does",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправляет текст, набранный не в той раскладке, и переводит выделенное."
          }
        }
      }
    },
    "General" : {
      "comment" : "Settings tab",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основные"
          }
        }
